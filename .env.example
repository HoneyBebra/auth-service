# Secrets + values that change between environments (dev/staging/prod).
# Everything else uses Settings defaults in src/core/config/.

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

# Must be the same as the name of the postgres service in the docker-compose file
POSTGRES_HOST=postgres_auth

POSTGRES_PORT=5432

# 0 = False, 1 = True
POSTGRES_ECHO=1

# optional: POSTGRES_POOL_SIZE, POSTGRES_MAX_OVERFLOW, POSTGRES_POOL_TIMEOUT — see PostgresSettings

JWT_SECRET_KEY=dev-jwt-secret-key-at-least-32-chars!!

# Must be the same as the name of the redis service in the docker-compose file
REDIS_HOST=redis_auth

REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=develop-password

# Fernet key (32 url-safe base64-encoded bytes). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_USER_DATA_SECRET_KEY=G8Kv5PIQOzItfcahj5KPEoSAAj5s92UfZQVHRA9wShI=

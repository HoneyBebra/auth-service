POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

# Must be the same as the name of the postgres service in the docker-compose file
POSTGRES_HOST=postgres_auth

POSTGRES_PORT=5432

# 0 = False, 1 = True
POSTGRES_ECHO=1

APP_NAME=auth
APP_DESCRIPTION=auth-service
APP_VERSION=0.1.0
APP_API_V1_PREFIX=/auth/api/v1
APP_PASSWORD_MIN_LENGTH=8
APP_BACKOFF_RETRIES_COUNT=10
APP_GRPC_PORT=50051

JWT_SECRET_KEY=VERY_SECRET
JWT_ALGORITHM=HS256

# Must be the same as the name of the redis service in the docker-compose file
REDIS_HOST=redis_auth

REDIS_PORT=6379
REDIS_DB=0

REDIS_PASSWORD=develop-password

# Fernet key (32 url-safe base64-encoded bytes)
ENCRYPTION_USER_DATA_SECRET_KEY=VERY_SECRET
